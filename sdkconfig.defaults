# ESP32 240MHz CPU Frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS 1000Hz Tick Rate
CONFIG_FREERTOS_HZ=1000

# Enable System Run-time stats & Task listing
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable Flash size 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Suppress legacy touch driver deprecation warning in ESP-IDF v6.1
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y
